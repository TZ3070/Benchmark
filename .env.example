# Every setting consumed by the backend must be present in the project-root .env.
# These addresses assume Python runs directly on the same host as LiteLLM/Postgres.
# For Docker Compose, change host addresses to values reachable from the container.
LITELLM_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=replace-with-your-litellm-key

# SpendLogs source: an external JSONL file or recursively scanned archive directory.
SPENDLOGS_JSONL=/srv/litellm/data/spendlogs
SPENDLOGS_MANIFEST=

# Postgres connection. Set POSTGRES_DSN empty to use the fields below.
POSTGRES_DSN=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=32100
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-your-postgres-password
# Benchmark API runtime settings.
BENCHMARK_API_KEY=replace-with-a-long-random-secret
BENCHMARK_HOST=127.0.0.1
BENCHMARK_PORT=8088
BENCHMARK_MAX_WORKERS=128
BENCHMARK_RESPONSE_READ_TIMEOUT=600
BENCHMARK_STATE_DB=./data/benchmark-state/benchmark.sqlite3

# Docker Compose only: persistent host directory for the task database.
BENCHMARK_STATE_HOST=./data/benchmark-state
SPENDLOGS_ARCHIVE_HOST=/srv/litellm/data/spendlogs
