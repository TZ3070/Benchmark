# Every setting consumed by app.py must be present in .env.
# These addresses assume Python runs directly on the same host as LiteLLM/Postgres.
# For Docker Compose, change host addresses to values reachable from the container.
LITELLM_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=replace-with-your-litellm-key

# SpendLogs source: JSONL file or recursively scanned archive directory.
SPENDLOGS_JSONL=./data/spendlogs
SPENDLOGS_MANIFEST=

# Postgres connection. Set POSTGRES_DSN empty to use the fields below.
POSTGRES_DSN=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=32100
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-your-postgres-password

# Prometheus is only used by GET /api/series; all values must still be declared.
PROMETHEUS_URL=http://127.0.0.1:9090
LITELLM_PROMETHEUS_METRIC=litellm_requests_metric
LITELLM_PROMETHEUS_QUERY_TEMPLATE=sum(rate({metric}{model="{model}"}[1m]))
LITELLM_PROMETHEUS_STEP=15s

# Benchmark API runtime settings.
BENCHMARK_HOST=127.0.0.1
BENCHMARK_PORT=8088
BENCHMARK_MAX_WORKERS=128
BENCHMARK_RESPONSE_READ_TIMEOUT=600
