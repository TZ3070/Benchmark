# Docker launch: set URLs reachable from the Benchmark container and its key.
# Python launch: export these variables in the shell before running app.py.
LITELLM_URL=http://host.docker.internal:4000
LITELLM_MASTER_KEY=replace-with-your-litellm-key

# Optional: only needed by GET /api/series; replay itself does not use Prometheus.
PROMETHEUS_URL=http://host.docker.internal:9090

# Docker only: host directory containing weekly full-table SpendLogs JSONL snapshots.
SPENDLOGS_ARCHIVE_HOST=./data/spendlogs

# Optional path inside the mounted archive directory to a newline-delimited file list.
# Leave blank to discover all *.jsonl files recursively.
SPENDLOGS_MANIFEST=

BENCHMARK_HOST_PORT=8088
LITELLM_PROMETHEUS_METRIC=litellm_requests_metric
# LITELLM_PROMETHEUS_QUERY_TEMPLATE=sum(rate({metric}{model="{model}"}[1m]))
